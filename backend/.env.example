# Environment Configuration
NODE_ENV=development
PORT=5000

# TMDB API Credentials (Required on backend only)
TMDB_API_KEY=your_tmdb_api_key_here

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://user:password@localhost:5432/streamflix?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamflix?schema=public

# Cache TTL Settings (in seconds)
CACHE_DEFAULT_TTL=3600
